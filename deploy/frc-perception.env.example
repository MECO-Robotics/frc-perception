# FRC team 8324 robot NetworkTables server.
FRC_NT_ENABLED=1
FRC_NT_MODE=client
FRC_TEAM_NUMBER=8324
FRC_NT_TABLE=/FRC/Perception/v1
FRC_CLUSTER_RADIUS_M=0.25
FRC_NT_STALE_MS=250

# The configured stereo camera. The service is packaged but not auto-started.
SCOUT_SOURCE=/dev/video0
# Optional second, independent side-by-side stereo camera. Each stereo camera
# gets its own YOLO detector; detection runs on its left eye and stereo depth
# uses both eyes. Set this only after choosing the second camera device. Give
# each independent stereo pair its own calibration; optional metric overrides
# apply only to camera 2.
# SCOUT_SOURCE_2=/dev/video2
# SCOUT_STEREO_CALIBRATION_2=media/calibration/stereo_camera_2.yml
# SCOUT_STEREO_BASELINE_M_2=0.0635
# SCOUT_STEREO_FOCAL_PX_2=1200
# FRC_NT_TABLE_2=/FRC/Perception/camera2
SCOUT_CAMERA_FORMAT=MJPG
SCOUT_CAMERA_WIDTH=3200
SCOUT_CAMERA_HEIGHT=1200
SCOUT_CAMERA_FPS=60
SCOUT_INFERENCE_WIDTH=1280
# Detector anchors run at 5 Hz; optical flow, Kalman tracking, and stereo
# refresh object positions between anchors.
SCOUT_INFERENCE_MAX_FPS=5
SCOUT_FLOW_WIDTH=640
SCOUT_OPENCV_THREADS=1
SCOUT_INFERENCE_ALWAYS=1
SCOUT_ENGINE=models/rebuilt_fuel_yolo26n_1280x960_fp16.engine
SCOUT_CONFIDENCE=0.05
SCOUT_NMS_IOU=0.15
SCOUT_MAX_BOX_ASPECT_RATIO=2.0
# Preview encoding competes with two-stream stereo throughput; enable only when needed.
SCOUT_STREAM_ENABLED=0
SCOUT_STEREO_CALIBRATION=media/calibration/stereo_calibration_live_order_candidate.yml
SCOUT_STEREO_DISPARITY_SCALE=1.0
SCOUT_STEREO_RECTIFY=1
SCOUT_STEREO_DENSE=0
SCOUT_STEREO_LOCAL_RECTIFY=1
SCOUT_STEREO_MATCH_SCALE=0.25
SCOUT_STEREO_NUM_DISPARITIES=32
SCOUT_STEREO_BLOCK_SIZE=3
SCOUT_STEREO_VERTICAL_ROI_PAD=24
SCOUT_STEREO_SIZE_GATE_MAX_REL_ERROR=0.55
SCOUT_STEREO_SIZE_GATE_DUPLICATE_IOU=0.90
SCOUT_TRACK_DIRECT_FLOW=1
SCOUT_TRACK_FLOW_GRACE_MS=250
